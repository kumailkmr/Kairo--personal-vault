# =========================================================================
# KAIRO OS — ENTERPRISE ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================================
# Copy this file to '.env' and populate the placeholders with your actual 
# Supabase credentials. Missing values will cause Kairo OS to fall back 
# to its high-fidelity mock database mode automatically.

# Supabase Public Endpoint URL (from your Supabase Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public API Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-placeholder-anon-key-here

# NextJS Port Configuration (Optional, defaults to 3000)
PORT=3000

# Node Environment Mode (development, production, testing)
NODE_ENV=development
